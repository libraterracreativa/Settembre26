<script>
/* NAV */
window.addEventListener('scroll',function(){document.getElementById('mainNav').classList.toggle('scrolled',window.scrollY>60);});

/* COUNTDOWN to Sept 15 2026 */
function updateCountdown(){
  var target = new Date('2026-09-15T23:59:59');
  var now = new Date();
  var diff = target - now;
  if(diff <= 0){
    document.getElementById('eb-banner').style.display = 'none';
    return;
  }
  var days = Math.floor(diff/86400000);
  var hours = Math.floor((diff%86400000)/3600000);
  var mins = Math.floor((diff%3600000)/60000);
  document.getElementById('cd-days').textContent = String(days).padStart(2,'0');
  document.getElementById('cd-hours').textContent = String(hours).padStart(2,'0');
  document.getElementById('cd-mins').textContent = String(mins).padStart(2,'0');
}
updateCountdown();
setInterval(updateCountdown, 60000);

/* FORM */
document.getElementById('vsForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var btn = document.getElementById('vs-submit');
  btn.disabled = true;
  btn.textContent = 'Invio in corso…';
  try {
    var nome  = document.getElementById('vs-nome').value.trim()  || '—';
    var email = document.getElementById('vs-email').value.trim() || '—';
    var tel   = document.getElementById('vs-tel').value.trim()   || '—';
    var quota = document.getElementById('vs-quota').value        || '—';
    var note  = document.getElementById('vs-note').value.trim()  || '—';
    var payload = {
      access_key: W3F_KEY,
      subject: 'Iscrizione Vivere Sostenibile – ' + quota,
      name: nome, email: email,
      message: [
        'PERCORSO: Vivere Sostenibile (10 incontri, sett–dic 2026)',
        'NOME: ' + nome,
        'EMAIL: ' + email,
        'TELEFONO: ' + tel,
        'QUOTA RICHIESTA: ' + quota,
        'MOTIVAZIONE: ' + note,
        '',
        'Rispondi con il link di pagamento per confermare il posto.'
      ].join('\n')
    };
    var controller = new AbortController();
    var timeout = setTimeout(function(){controller.abort();}, 10000);
    var resp = await fetch('https://api.web3forms.com/submit', {
      method: 'POST', signal: controller.signal,
      headers: {'Content-Type':'application/json','Accept':'application/json'},
      body: JSON.stringify(payload)
    });
    clearTimeout(timeout);
    var result = await resp.json();
    if(result.success){
      document.getElementById('vsForm').style.display = 'none';
      document.getElementById('vs-success').style.display = 'flex';
    } else { throw new Error(result.message || 'Errore'); }
  } catch(err){
    btn.disabled = false;
    btn.textContent = 'Invia richiesta di iscrizione →';
    if(err.name==='AbortError'){alert('Richiesta scaduta. Scrivi direttamente a alice@aliceful.it');}
    else{alert('Errore: '+(err.message||'sconosciuto')+'\nScrivi a alice@aliceful.it');}
  }
});

/* REVEAL */
var io = new IntersectionObserver(function(entries){
  entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('in');});
},{threshold:0.10});
document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
</script>
